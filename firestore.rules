rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'epoch', 'action', 'operator'])
        && data.keys().size() <= 12
        && data.id is string && data.id.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 64
        && (data.epoch is number || data.epoch is int)
        && data.action is string && data.action.size() <= 64
        && data.operator is string && data.operator.size() <= 128
        && (!data.keys().contains('title') || data.title is string)
        && (!data.keys().contains('draftMeta') || data.draftMeta is string)
        && (!data.keys().contains('referencesCount') || (data.referencesCount is number || data.referencesCount is int))
        && (!data.keys().contains('wordCount') || (data.wordCount is number || data.wordCount is int))
        && (!data.keys().contains('articleBody') || data.articleBody is string);
    }

    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId) && isValidAuditLog(request.resource.data);
    }
  }
}
