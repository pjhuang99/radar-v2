# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls (server-side only).
DEEPSEEK_API_KEY=""

# DEEPSEEK_MODEL: DeepSeek model ID. Default "deepseek-flash" (V4.1-Flash).
DEEPSEEK_MODEL="deepseek-flash"

# DEEPSEEK_BASE_URL: DeepSeek OpenAI-compatible endpoint. Default "https://api.deepseek.com/v1".
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# DEEPSEEK_THINKING: "disabled" (default) or "enabled".
# Keep disabled: V4.1+ thinking mode burns max_tokens on reasoning_content and can
# return an empty content (blank draft), and it makes the server ignore temperature.
DEEPSEEK_THINKING="disabled"

# ANYSEARCH_API_KEY: Required for AnySearch topic-driven news search.
ANYSEARCH_API_KEY=""
